{
  "name": "Semantic Versioning Test Suite",
  "pattern": "^v?(?P<major>0|[1-9]\\d*)\\.(?P<minor>0|[1-9]\\d*)\\.(?P<patch>0|[1-9]\\d*)(?:-(?P<prerelease>[0-9A-Za-z.-]+))?(?:\\+(?P<buildmetadata>[0-9A-Za-z.-]+))?$",
  "tests": [
    {
      "name": "simple semver",
      "input": "1.0.0",
      "should_match": true,
      "named_groups": {
        "major": "1",
        "minor": "0",
        "patch": "0",
        "prerelease": null,
        "buildmetadata": null
      }
    },
    {
      "name": "semver with v prefix and prerelease",
      "input": "v2.1.3-alpha.1",
      "should_match": true,
      "named_groups": {
        "major": "2",
        "minor": "1",
        "patch": "3",
        "prerelease": "alpha.1",
        "buildmetadata": null
      }
    },
    {
      "name": "semver with build metadata",
      "input": "1.0.0+20130313144700",
      "should_match": true,
      "named_groups": {
        "major": "1",
        "minor": "0",
        "patch": "0",
        "prerelease": null,
        "buildmetadata": "20130313144700"
      }
    },
    {
      "name": "invalid leading zero in major",
      "input": "01.2.3",
      "should_match": false
    }
  ]
}
