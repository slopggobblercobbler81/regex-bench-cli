{
  "name": "Email Validation Test Suite",
  "pattern": "^(?P<user>[a-zA-Z0-9_.+-]+)@(?P<domain>[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)+)$",
  "flags": ["IGNORECASE"],
  "tests": [
    {
      "name": "standard email",
      "input": "developer@example.com",
      "should_match": true,
      "groups": ["developer", "example.com"],
      "named_groups": {
        "user": "developer",
        "domain": "example.com"
      },
      "max_ms": 10.0
    },
    {
      "name": "email with plus addressing and dots",
      "input": "jane.doe+newsletter@sub.corp.domain.org",
      "should_match": true,
      "groups": ["jane.doe+newsletter", "sub.corp.domain.org"],
      "named_groups": {
        "user": "jane.doe+newsletter",
        "domain": "sub.corp.domain.org"
      },
      "max_ms": 10.0
    },
    {
      "name": "missing at sign",
      "input": "invalidemail.org",
      "should_match": false
    },
    {
      "name": "missing domain suffix",
      "input": "user@localhost",
      "should_match": false
    },
    {
      "name": "spaces in user",
      "input": "user name@example.com",
      "should_match": false
    }
  ]
}
